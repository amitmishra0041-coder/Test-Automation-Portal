# ── ClaimCenter environments ──────────────────────────────────────────────
# Same two-axis convention as the ClaimCenter-Automation repo:
#   TIER selects WHICH INSTANCE (test | dev) of each platform.
# Both platforms are targeted in a single run (Section A/L of the
# architecture doc — one process, two BrowserContexts per claim), so both
# URL pairs below must be reachable from wherever this runs.
CC_TIER=test

CC_BASE_URL_ONPREM_TEST=http://test-claimcenter.donegalgroup.com/cc/ClaimCenter.do
CC_BASE_URL_ONPREM_DEV=http://dev-claimcenter.donegalgroup.com:8080/cc/ClaimCenter.do
CC_BASE_URL_CLOUD_TEST=https://cc-test-dngldev.donegal.beta5-andromeda.guidewire.net/ClaimCenter.do
CC_BASE_URL_CLOUD_DEV=https://cc-dev-dngldev.donegal.beta5-andromeda.guidewire.net/ClaimCenter.do

# ── Credentials ────────────────────────────────────────────────────────────
# NEVER commit real values here. Both platforms use plain username/password
# form login (no SSO/MFA) as of this writing — see AuthProvider (Section N).
CC_USER=
CC_PASS=
# Optional: only needed if a specific section requires elevated rights
# (e.g. on-prem claim close required the admin "su" account in the sister repo).
CC_ADMIN_USER=
CC_ADMIN_PASS=

# ── Run behavior ─────────────────────────────────────────────────────────
# Number of claims processed concurrently. Each worker opens its OWN pair of
# BrowserContexts (one per platform) so sessions never bleed across claims.
# Default kept conservative — see Section L's note on on-prem background-job
# load before raising this for a full 500-claim batch.
WORKERS=4

# Report formats to generate, comma-separated: html,json,csv,xlsx
REPORT_FORMATS=html,json,csv,xlsx

# Evidence capture policy: unexpected-only (default) | all | none
SCREENSHOT_ON=unexpected-only

# Comparison tolerances (Section G)
CURRENCY_TOLERANCE=0.01
DATE_TOLERANCE_DAYS=0

# ── Output locations (rarely need to change) ────────────────────────────
REPORTS_DIR=reports
EVIDENCE_DIR=evidence

index 0000000..94cf965
--- /dev/null
+++ b/tests/Regression/ClaimHandling.regression.test.js
@@ -0,0 +1,124 @@
+/**
+ * tests/Regression/ClaimHandling.regression.test.js — Regression Test Design V1.0: Claim Handling (TC024–TC026),
+ * VindicateRecallListAPI (TC033), CCC (TC041, TC042). Cloud ClaimCenter.
+ */
+const { test } = require('@playwright/test');
+const S = require('../../helpers/regression/regressionSteps');
+const { R, W, B, A } = S;
+
+S.hooks(test);
+
+test('RG-TC024 [Claim Handling]: Post-FNOL vehicle incident with all vehicle details', async ({ page }, ti) => S.blockable(test, async () => {
+  const cn = await S.claimFor(page, ti, 'REG_CLAIM_PA', 'PA', 'RG-TC024');
+  await A.openLossDetailsGeneral(page);
+  await W.clickButton(page, 'Edit');
+  // Vehicles list-view toolbar "Add" on Loss Details (same LV EditableVehicleIncidentsLV wizardDriver.addIncidentLoan opens).
+  const add = page.locator('[id*="EditableVehicleIncidentsLV_tb-Add"], [id*="VehicleIncidents"][id$="-Add"]').first();
+  if (!(await add.isVisible().catch(() => false))) throw new W.Blocked('no Add button in the Vehicles section of Loss Details');
+  await add.click();
+  await W.settle(page, 3500);
+  const v = { Year: '2021', Make: 'Honda', Model: 'Accord', Color: 'Blue', VIN: '1HGCV1F34MA000301', 'License Plate': `RG${Date.now().toString().slice(-5)}`, 'Damage Description': 'Regression TC024 rear bumper damage' };
+  for (const [label, value] of Object.entries(v)) await W.fill(page, label, value).catch(() => ti.annotations.push({ type: 'manual', description: `"${label}" field not found on the vehicle incident screen` }));
+  for (const label of ['Loss Party', 'Driver Name', 'Owner']) await W.select(page, label, 0).catch(() => {});
+  await A.fillRequired(page).catch(() => {});
+  await R.step(page, ti, `Vehicle incident entered: ${JSON.stringify(v)}`);
+  await W.clickButton(page, 'OK');
+  const saved = await S.editAndUpdate(page, async () => {}, 'Loss Details').catch(() => ({ saved: false, messages: [] }));
+  const rows = await R.gridRows(page);
+  await R.check(page, ti, { description: 'Vehicle incident saved on Loss Details', expected: `2021 Honda Accord (${v.VIN})`, actual: rows.filter((r) => /Honda|Accord/i.test(r)).join(' | ') || `not listed — ${saved.messages.join(' | ')}`, ok: rows.some((r) => /Accord/i.test(r)) });
+  R.setClaim(ti, cn);
+}));
+
+test('RG-TC025 [Claim Handling]: DWF Loss Details — loss location, loss cause, incident types', async ({ page }, ti) => S.blockable(test, async () => {
+  const cn = await S.claimFor(page, ti, 'REG_CLAIM_DF', 'DF', 'RG-TC025');
+  await A.openLossDetailsGeneral(page);
+  const s = await S.readScreen(page);
+  const loc = S.findField(s, 'Loss Location') || S.findField(s, 'Location'), cause = S.findField(s, 'Loss Cause');
+  await R.check(page, ti, { description: 'Loss Location and Loss Cause on Loss Details', expected: 'both fields shown', actual: `Location: ${loc ? loc.value || '(empty)' : 'missing'}; Loss Cause: ${cause ? cause.value || '(empty)' : 'missing'}`, ok: !!loc && !!cause });
+  await W.clickButton(page, 'Edit');
+  const addBtn = page.getByRole('button', { name: /^Add$/ }).first();
+  await addBtn.click().catch(() => {});
+  await W.settle(page, 1500);
+  const items = await W.visibleMenuItems(page);
+  await R.check(page, ti, { description: 'Loss Items › Add offers multiple incident types', expected: '2+ incident types', actual: items.join(' | ') || 'no menu', ok: items.length >= 2 });
+  await W.closeMenus(page);
+  await page.getByRole('button', { name: 'Cancel', exact: true }).first().click().catch(() => {});
+  R.setClaim(ti, cn);
+}));
+
+test('RG-TC026 [Claim Handling]: Notes at FNOL and post-FNOL (CPP)', async ({ page }, ti) => S.blockable(test, async () => {
+  const claim = await S.pooledClaim(page, 'CP', 'RG-TC026', { assignmentType: 'Bodily Injury', lossCause: 'LC03' });
+  R.setClaim(ti, claim.cn, process.env.CC_USER);
+  const addNote = async (text) => {
+    await S.action(page, /^Note$|New Note/i);
+    await A.selectByLabel(page, 'Topic', /^(?!<none>$).+/).catch(() => {});
+    const body = page.locator('textarea').filter({ visible: true }).first();
+    await body.fill(text);
+    await W.clickButton(page, 'Update');
+  };
+  const t1 = `Regression TC026 note at FNOL ${Date.now()}`;
+  await B.openExistingClaim(page, claim.cn);
+  await addNote(t1);
+  await R.step(page, ti, `Note 1 added right after FNOL: ${t1}`);
+  await page.goto(B.BASE_URL, { waitUntil: 'domcontentloaded' });
+  await B.openExistingClaim(page, claim.cn);
+  const t2 = `Regression TC026 post-FNOL note ${Date.now()}`;
+  await addNote(t2);
+  await S.nav(page, 'Notes');
+  const body = await S.bodyText(page);
+  await R.check(page, ti, { description: 'Both notes listed on Notes', expected: `${t1} and ${t2}`, actual: `${body.includes(t1) ? 'note 1 shown' : 'note 1 missing'}, ${body.includes(t2) ? 'note 2 shown' : 'note 2 missing'}`, ok: body.includes(t1) && body.includes(t2) });
+  ti.annotations.push({ type: 'manual', description: 'A note inside the FNOL wizard itself is not driven — note 1 is added right after Finish.' });
+}));
+
+test('RG-TC033 [VindicateRecallListAPI]: Vehicle Recall on a vehicle exposure', async ({ page }, ti) => S.blockable(test, async () => {
+  // Its own claim (the exposure gets closed) — never the shared registry claim.
+  const cn = process.env.REG_CLAIM_PA_RECALL || (await S.fileClaim(page, 'PA', 'RG-TC033', { assignmentType: 'Casualty', lossCause: 'LC15', pool: false })).cn;
+  await B.loginToClaimCenter(page);
+  await R.makeViewable(page, cn);
+  await S.openExposureMatching(page, 'Collision|Comprehensive');
+  const s = await S.readScreen(page);
+  const btn = s.buttons.find((b) => /vehicle recall/i.test(b));
+  await R.check(page, ti, { description: 'Vehicle Recall button on the vehicle exposure', expected: 'Vehicle Recall', actual: btn || `buttons: ${s.buttons.join(', ').slice(0, 300)}`, ok: !!btn });
+  await W.clickButton(page, btn);
+  const after = await S.bodyText(page);
+  await R.check(page, ti, { description: 'Vehicle Recall page shows decoded status and recall list', expected: 'decode status + recall list', actual: after.slice(0, 400), ok: /recall/i.test(after) && /decod|status/i.test(after) });
+  // Steps 6–7: close the exposure (open activities completed first, DMEC0002 accepted) and re-open Vehicle Recall.
+  const c = await S.closeExposure(page, cn, 'Collision|Comprehensive', { acceptDmec: true });
+  await R.check(page, ti, { description: 'Vehicle exposure closed', expected: 'closed', actual: `${c.closed ? 'closed' : 'not closed'} ${c.messages.join(' | ')}`, ok: c.closed });
+  await S.openExposureMatching(page, 'Collision|Comprehensive');
+  const s2 = await S.readScreen(page);
+  const btn2 = s2.buttons.find((b) => /vehicle recall/i.test(b));
+  if (btn2) await W.clickButton(page, btn2);
+  const after2 = await S.bodyText(page);
+  await R.check(page, ti, { description: 'Vehicle Recall still shows decoded status + recall list on the closed exposure', expected: 'recall details', actual: btn2 ? after2.slice(0, 300) : 'no Vehicle Recall button on the closed exposure', ok: !!btn2 && /recall/i.test(after2) });
+  R.setClaim(ti, cn);
+}));
+
+test('RG-TC041 [CCC]: Appraisal tab on an existing claim vehicle incident; Point of Impact required', async ({ page }, ti) => S.blockable(test, async () => {
+  const cn = await S.claimFor(page, ti, 'REG_CLAIM_PA', 'PA', 'RG-TC041');
+  await S.openExposureMatching(page, 'Collision|Comprehensive');
+  await page.getByText('Appraisal', { exact: true }).first().click().catch(() => {});
+  await W.settle(page, 2000);
+  const body = await S.bodyText(page);
+  await R.check(page, ti, { description: 'Appraisal tab available', expected: 'Appraisal tab opens', actual: /Point of Impact/i.test(body) ? 'Appraisal content shown' : body.slice(0, 200), ok: /Point of Impact/i.test(body) });
+  await W.clickButton(page, 'Edit');
+  const poi = S.findField(await S.readScreen(page), 'Primary Point of Impact') || S.findField(await S.readScreen(page), 'Point of Impact');
+  await R.check(page, ti, { description: 'Point of Impact is required', expected: 'required', actual: poi ? `required=${poi.required}` : 'field not found', ok: !!poi && poi.required });
+  await page.getByRole('button', { name: 'Cancel', exact: true }).first().click().catch(() => {});
+  R.setClaim(ti, cn);
+}));
+
+test('RG-TC042 [CCC]: CCC Claim View button launches CCC', async ({ page }, ti) => S.blockable(test, async () => {
+  const cn = await S.claimFor(page, ti, 'REG_CLAIM_PA', 'PA', 'RG-TC042');
+  await S.openExposureMatching(page, 'Collision|Comprehensive');
+  const s = await S.readScreen(page);
+  const btn = s.buttons.find((b) => /CCC/i.test(b));
+  await R.check(page, ti, { description: 'CCC Claim View button on the vehicle exposure', expected: 'CCC Claim View', actual: btn || `buttons: ${s.buttons.join(', ').slice(0, 300)}`, ok: !!btn });
+  const popup = page.waitForEvent('popup', { timeout: 20000 }).catch(() => null);
+  await page.getByRole('button', { name: btn, exact: true }).first().click();
+  const p = await popup;
+  await R.step(page, ti, `CCC launch: ${p ? `new window ${p.url()}` : 'no new window within 20s'}`);
+  ti.annotations.push({ type: 'manual', description: 'Confirm by hand that CCC shows the claim after SSO (external site).' });
+  if (p) await p.close().catch(() => {});
+  R.setClaim(ti, cn);
+}));
diff --git a/tests/Regression/Contacts.regression.test.js b/tests/Regression/Contacts.regression.test.js
new file mode 100644
index 0000000..4b891f6
--- /dev/null
+++ b/tests/Regression/Contacts.regression.test.js
@@ -0,0 +1,116 @@
+/**
+ * tests/Regression/Contacts.regression.test.js — Regression Test Design V1.0: Contact Manager (TC005, TC006) and
+ * Intersuite CC - CM (TC022, TC023). Cloud ClaimCenter.
+ */
+const { test } = require('@playwright/test');
+const S = require('../../helpers/regression/regressionSteps');
+const { R, W, B } = S;
+
+S.hooks(test);
+
+const PHONE_FMT = /\(\d{3}\) \d{3}-\d{4}/;
+
+// Parties Involved › Contacts grid rows (name / roles / phone / address), read as text rows.
+async function contactRows(page) {
+  await W.navigate(page, 'parties');
+  await S.nav(page, 'Contacts').catch(() => {});
+  return (await R.gridRows(page)).filter((r) => !/^Name\s+Roles?/i.test(r));
+}
+
+test('RG-TC005 [Contact Manager]: FNOL auto-populates Insured, Agent, Underwriter, Driver with roles and phone format', async ({ page }, ti) => S.blockable(test, async () => {
+  const claim = await S.pooledClaim(page, 'PA', 'RG-TC005', { assignmentType: 'Casualty', lossCause: 'LC15' });
+  R.setClaim(ti, claim.cn, process.env.CC_USER);
+  await B.openExistingClaim(page, claim.cn);
+  const rows = await contactRows(page);
+  await R.step(page, ti, `Parties Involved › Contacts on ${claim.cn}: ${rows.join(' || ')}`);
+  for (const role of ['Insured', 'Agent', 'Underwriter', 'Driver']) {
+    const hit = rows.find((r) => new RegExp(`\\b${role}\\b`, 'i').test(r));
+    await R.check(page, ti, { description: `${role} contact auto-populated`, expected: `a row with role ${role}`, actual: hit || 'none', ok: !!hit });
+    const want = process.env[`REG_PC_${role.toUpperCase()}`];
+    if (want) await R.check(page, ti, { description: `${role} name matches PolicyCenter`, expected: want, actual: hit || 'none', ok: !!hit && hit.toUpperCase().includes(want.toUpperCase()) });
+  }
+  const phones = rows.map((r) => (r.match(/\(?\d{3}\)?[ .-]?\d{3}-?\d{4}/) || [])[0]).filter(Boolean);
+  await R.check(page, ti, { description: 'Phone numbers display as (XXX) XXX-XXXX', expected: '(XXX) XXX-XXXX', actual: phones.join(', ') || 'no phone numbers in the grid', ok: phones.length > 0 && phones.every((p) => PHONE_FMT.test(p)) });
+  // Names vs PolicyCenter: read the policy's Summary / Contacts in PC (read-only) and look for each CC contact's surname.
+  if (S.PC.configured()) {
+    const pc = await S.PC.policyParties(page, claim.policyNumber);
+    const pcText = (pc.summary + '\n' + pc.contacts).toUpperCase();
+    for (const role of ['Insured', 'Agent', 'Underwriter', 'Driver']) {
+      const row = rows.find((r) => new RegExp(`\\b${role}\\b`, 'i').test(r));
+      if (!row) continue;
+      const surname = row.trim().split(/\s+/).filter((w) => /^[A-Z][A-Za-z'-]{2,}$/.test(w)).slice(-1)[0] || '';
+      await R.check(page, ti, { description: `${role} matches PolicyCenter (${claim.policyNumber})`, expected: row.slice(0, 60), actual: surname && pcText.includes(surname.toUpperCase()) ? `${surname} found in PC` : `${surname || '?'} not found in PC`, ok: !!surname && pcText.includes(surname.toUpperCase()) });
+    }
+  } else if (!['INSURED', 'AGENT', 'UNDERWRITER', 'DRIVER'].some((r) => process.env[`REG_PC_${r}`])) ti.annotations.push({ type: 'manual', description: 'PolicyCenter name match not checked — set REG_PC_USER / REG_PC_PASS (or REG_PC_INSURED / _AGENT / _UNDERWRITER / _DRIVER).' });
+}));
+
+test('RG-TC006 [Contact Manager]: Person contact phone number and extension validation', async ({ page }, ti) => S.blockable(test, async () => {
+  const cn = await S.claimFor(page, ti, 'REG_CLAIM_PA', 'PA', 'RG-TC006');
+  await W.navigate(page, 'parties');
+  await page.locator('[id$="ClaimContacts_CreateNewContactButton"]').first().click(); // same control wizardDriver.addClaimPersonContact uses
+  await page.waitForTimeout(1500);
+  await page.getByRole('menuitem', { name: /^Person$/ }).first().click();
+  await W.settle(page, 4000);
+  await W.fill(page, 'First name', 'Regression');
+  await W.fill(page, 'Last name', `Phone${Date.now().toString().slice(-5)}`);
+  const phoneLabel = (S.findField(await S.readScreen(page), 'Work Phone') || S.findField(await S.readScreen(page), 'Primary Phone') || S.findField(await S.readScreen(page), 'Home Phone') || {}).label;
+  if (!phoneLabel) throw new W.Blocked('no Work/Primary/Home Phone field on the New Person contact screen');
+  const extLabel = (S.findField(await S.readScreen(page), `${phoneLabel} Ext`) || S.findField(await S.readScreen(page), 'Extension') || S.findField(await S.readScreen(page), 'Ext') || {}).label;
+  const tryPhone = async (value) => { await W.fill(page, phoneLabel, value); const f = await S.field(page, phoneLabel); return { shown: f ? f.value : '', msgs: (await R.pageMessages(page)).filter((m) => /phone|digit|invalid/i.test(m)) }; };
+  const cases = [
+    { v: '12345', desc: 'fewer than 10 digits', ok: (r) => r.msgs.length > 0 || r.shown.replace(/\D/g, '').length !== 5 },
+    { v: '123456789012', desc: 'more than 10 digits', ok: (r) => r.msgs.length > 0 || r.shown.replace(/\D/g, '').length <= 10 },
+    { v: 'ABCDEFGHIJ', desc: 'alphabetic', ok: (r) => r.msgs.length > 0 || !/[A-Z]/i.test(r.shown) },
+    { v: '8005551234', desc: 'valid 10 digits', ok: (r) => PHONE_FMT.test(r.shown) || /^\d{3}-\d{3}-\d{4}$/.test(r.shown) },
+  ];
+  for (const c of cases) {
+    const r = await tryPhone(c.v);
+    await R.check(page, ti, { description: `Phone ${c.desc} (${c.v})`, expected: c.desc === 'valid 10 digits' ? 'accepted, formatted (XXX) XXX-XXXX' : 'rejected or truncated', actual: `shows "${r.shown}"${r.msgs.length ? ` — ${r.msgs.join(' | ')}` : ''}`, ok: c.ok(r) });
+  }
+  if (extLabel) {
+    await W.fill(page, extLabel, '7318');
+    await R.check(page, ti, { description: 'Extension 1–4 digits accepted', expected: '7318', actual: (await S.field(page, extLabel) || {}).value, ok: /7318/.test((await S.field(page, extLabel) || {}).value || '') });
+    await W.fill(page, extLabel, '73189');
+    const v = (await S.field(page, extLabel) || {}).value || '';
+    const m = (await R.pageMessages(page)).filter((x) => /ext/i.test(x));
+    await R.check(page, ti, { description: 'Extension over 4 digits rejected or truncated', expected: 'error or ≤ 4 digits', actual: `"${v}" ${m.join(' | ')}`, ok: v.replace(/\D/g, '').length <= 4 || m.length > 0 });
+    await W.fill(page, extLabel, '');
+  } else ti.annotations.push({ type: 'manual', description: 'No Extension field next to the phone on this screen — extension steps 7–9 by hand.' });
+  if (process.env.REG_SAVE_CONTACTS === '1') {
+    await W.fill(page, phoneLabel, '8005551234');
+    await W.clickButton(page, 'Update');
+    await R.step(page, ti, `Saved the contact: ${(await R.pageMessages(page)).join(' | ') || 'no messages'}`);
+  } else {
+    await W.clickButton(page, 'Cancel').catch(() => {});
+    ti.annotations.push({ type: 'manual', description: 'Contact cancelled, not saved (set REG_SAVE_CONTACTS=1 to save it).' });
+  }
+  R.setClaim(ti, cn);
+}));
+
+// Insured / Covered Party on a PolicyCenter claim: Edit is refused with "All changes to this contact must be made in PolicyCenter".
+async function editBlocked(page, ti, role) {
+  const rows = await contactRows(page);
+  const row = rows.find((r) => new RegExp(`\\b${role}\\b`, 'i').test(r));
+  if (!row) throw new W.Blocked(`no ${role} contact on this claim (contacts: ${rows.join(' || ').slice(0, 300)})`);
+  const name = row.split(/\s{2,}|\t/)[0].split(' ').slice(0, 3).join(' ');
+  await page.locator('tr[role="row"]').filter({ hasText: role }).first().click();
+  await W.settle(page, 2500);
+  const editBtn = page.getByRole('button', { name: 'Edit', exact: true }).first();
+  const editable = await editBtn.isVisible().catch(() => false) && await editBtn.isEnabled().catch(() => false);
+  if (editable) { await editBtn.click(); await W.settle(page, 2500); }
+  const text = (await R.pageMessages(page)).concat(await S.bodyText(page).then((b) => (b.match(/All changes to this contact must be made in PolicyCenter[^\n]*/i) || [])));
+  const msg = text.find((t) => /must be made in PolicyCenter/i.test(t));
+  await R.check(page, ti, { description: `Edit of the PC ${role} contact (${name}) is blocked`, expected: '"All changes to this contact must be made in PolicyCenter"', actual: msg || (editable ? 'Edit opened with no PolicyCenter message' : 'Edit not offered, no message'), ok: !!msg });
+  await page.getByRole('button', { name: 'Cancel', exact: true }).first().click().catch(() => {});
+}
+
+test('RG-TC022 [Intersuite CC - CM]: Edits on PC insured contacts are blocked', async ({ page }, ti) => S.blockable(test, async () => {
+  await S.claimFor(page, ti, 'REG_CLAIM_PA', 'PA', 'RG-TC022');
+  await editBlocked(page, ti, 'Insured');
+}));
+
+test('RG-TC023 [Intersuite CC - CM]: Edits on Covered Party contacts are blocked', async ({ page }, ti) => S.blockable(test, async () => {
+  S.need(test, 'REG_CLAIM_COVERED_PARTY');
+  await S.claimFor(page, ti, 'REG_CLAIM_COVERED_PARTY', 'PA', 'RG-TC023');
+  await editBlocked(page, ti, 'Covered Party');
+}));
diff --git a/tests/Regression/Extended.regression.test.js b/tests/Regression/Extended.regression.test.js
new file mode 100644
index 0000000..59dd5c9
--- /dev/null
+++ b/tests/Regression/Extended.regression.test.js
@@ -0,0 +1,205 @@
+/**
+ * tests/Regression/Extended.regression.test.js — cases ADDED beyond Regression Test Design V1.0 (ids RX001…), so the
+ * flows V1.0 checks on one or two LOBs are also checked on the others, and the integrations ClaimCenter depends on
+ * (SmartCOMM, OneInc check/void, Contact Manager, recovery receipts) have a regression case of their own.
+ *
+ * Same building blocks as the V1.0 specs (helpers/regression/regressionSteps.js). Claims that get closed or written to
+ * heavily are filed fresh per case; read-mostly cases use the financialRules shared-claim registry.
+ */
+const { test } = require('@playwright/test');
+const S = require('../../helpers/regression/regressionSteps');
+const { R, W, B, A, E, F, P, CO } = S;
+
+S.hooks(test);
+
+const ROUTE = {
+  HO: { assignmentType: 'First Party', lossCause: 'LC01', exposure: 'Coverage A', reserveLine: 'Dwelling|Coverage A' },
+  WC: { assignmentType: '', lossCause: 'LC07', exposure: 'Medical', reserveLine: 'Medical|Workers' },
+  CA: { assignmentType: 'Casualty', lossCause: 'LC15', exposure: 'Collision', reserveLine: 'Collision' },
+  BOP: { assignmentType: 'Bodily Injury', lossCause: 'LC03', exposure: 'Business Liability', reserveLine: 'Liability|Bodily' },
+  CP: { assignmentType: 'Bodily Injury', lossCause: 'LC03', exposure: 'Premises', reserveLine: 'Premises|Liability|Bodily' },
+  PA: { assignmentType: 'Casualty', lossCause: 'LC15', exposure: 'Collision', reserveLine: 'Collision' },
+  GL: { assignmentType: 'Bodily Injury', lossCause: 'LC03', exposure: 'Premises', reserveLine: 'Premises|Liability' },
+};
+// share = draw from / feed the claim pool; own = a claim this case uses up (closed, or asserts a brand-new activity).
+const share = (page, kind, tag) => S.pooledClaim(page, kind, tag, { assignmentType: ROUTE[kind].assignmentType, lossCause: ROUTE[kind].lossCause });
+const own = (page, kind, tag) => S.fileClaim(page, kind, tag, { assignmentType: ROUTE[kind].assignmentType, lossCause: ROUTE[kind].lossCause, pool: false });
+
+// ── Financials on every LOB (V1.0 TC067 / TC073 are Personal Auto only) ───────────────────────────────────────────
+const FIN = [['RX001', 'HO', 'Homeowners'], ['RX002', 'WC', "Workers' Comp"], ['RX003', 'CA', 'Commercial Auto'], ['RX004', 'BOP', 'BOP'], ['RX005', 'CP', 'Commercial Package']];
+for (const [id, kind, lob] of FIN) {
+  test(`RG-${id} [Financials - LOB variants]: ${lob} reserve, payment within reserves, TXV11000 above reserves`, async ({ page }, ti) => S.blockable(test, async () => {
+    const r = ROUTE[kind];
+    const { cn } = await share(page, kind, `RG-${id}`);
+    R.setClaim(ti, cn, 'su');
+    await R.asAdmin(page, cn);
+    await E.repairCloud(page, cn).catch(() => {});
+    const said = await F.createReserve(page, { reserveAmount: 1000, exposure: r.exposure, strict: false });
+    const tx = await R.transactionRows(page, cn);
+    await R.check(page, ti, { description: `${lob}: reserve $1,000 on ${r.exposure}`, expected: 'reserve row', actual: tx.filter((x) => /Reserve/i.test(x)).join(' | ') || `none ${said || ''}`, ok: tx.some((x) => /Reserve/i.test(x) && /1,000\.00/.test(x)) });
+    await R.asStandard(page, cn);
+    const ok = await P.makePayment(page, { reserveLine: `match:${r.reserveLine}`, amount: P.uniqueAmount(40) });
+    const row = (await R.transactionRows(page, cn)).find((x) => x.includes(Number(ok.amount).toLocaleString('en-US', { minimumFractionDigits: 2 })));
+    await R.check(page, ti, { description: `${lob}: payment within reserves created`, expected: `$${ok.amount}`, actual: row || ok.messages.join(' | ') || 'not found', ok: !!row });
+    await B.openExistingClaim(page, cn);
+    const big = await P.makePayment(page, { reserveLine: `match:${r.reserveLine}`, amount: '1500.37' });
+    await R.check(page, ti, { description: `${lob}: TXV11000 blocks a payment above available reserves`, expected: 'exceeds available reserves', actual: `${big.finished ? 'FINISHED' : 'refused'} — ${big.messages.join(' | ')}`, ok: !big.finished && big.messages.some((m) => /exceed/i.test(m)) });
+  }));
+}
+
+// ── Full close on every LOB (DMEC0002, activity sweep, exposure + claim close — e2eSteps.close) ─────────────────────
+const CLOSE = [['RX006', 'PA', 'Personal Auto'], ['RX007', 'HO', 'Homeowners'], ['RX008', 'WC', "Workers' Comp"], ['RX009', 'CA', 'Commercial Auto']];
+for (const [id, kind, lob] of CLOSE) {
+  test(`RG-${id} [Claim Lifecycle - LOB variants]: ${lob} claim drains, closes exposures and closes`, async ({ page }, ti) => S.blockable(test, async () => {
+    const { cn } = await own(page, kind, `RG-${id}`);
+    R.setClaim(ti, cn, 'su');
+    await R.asAdmin(page, cn);
+    await E.repairCloud(page, cn).catch(() => {});
+    await F.createReserve(page, { reserveAmount: 600, exposure: ROUTE[kind].exposure, strict: false });
+    await E.close(page, cn);
+    await B.openExistingClaim(page, cn);
+    const st = ((await S.bodyText(page)).match(/St:\s*(\w+)/) || [])[1] || '';
+    await R.check(page, ti, { description: `${lob}: claim status`, expected: 'Closed', actual: st, ok: /Closed/i.test(st) });
+    const open = (await R.hasActivity(page, /./, cn)).rows.filter((x) => /\bOpen\b/.test(x));
+    await R.check(page, ti, { description: `${lob}: no open activities left`, expected: '0', actual: open.slice(0, 3).join(' || ') || '0', ok: !open.length });
+    const tx = await R.transactionRows(page, cn);
+    await R.step(page, ti, `Transactions after close: ${tx.slice(0, 6).join(' || ')}`);
+  }));
+}
+
+// ── Medicare tab on liability BI exposures (V1.0 TC038 covers WC Medical + Auto PIP) ───────────────────────────────
+const MED = [['RX010', 'CA', 'Commercial Auto'], ['RX011', 'GL', 'General Liability'], ['RX012', 'BOP', 'BOP']];
+for (const [id, kind, lob] of MED) {
+  test(`RG-${id} [MSP Navigator - LOB variants]: ${lob} Bodily Injury exposure — Medicare beneficiary + ICD saved`, async ({ page }, ti) => S.blockable(test, async () => {
+    const N = require('../../helpers/oneInc/needsData');
+    const { cn } = await S.pooledClaim(page, kind, `RG-${id}`, { poolKey: `${kind}:BI`, assignmentType: 'Bodily Injury', lossCause: 'LC03', exposures: [{ coverageLabel: ['Bodily Injury', 'Bodily Injury Liability', 'Premises/Operations', 'Business Liability'] }] });
+    R.setClaim(ti, cn, process.env.CC_USER);
+    const said = await N.setExposureMedicare(page, 'Bodily Injury|Liability|Premises', { beneficiary: 'Yes', icd: 'S13.4XXA' });
+    await R.step(page, ti, String(said || 'Medicare set'));
+    await page.getByText('Medicare', { exact: true }).first().click().catch(() => {});
+    await W.settle(page, 2000);
+    const s = await S.readScreen(page);
+    const ben = S.findField(s, 'Is Claimant a Medicare Beneficiary?');
+    await R.check(page, ti, { description: `${lob}: Medicare beneficiary saved`, expected: 'Yes', actual: ben ? JSON.stringify(ben.radios || ben.value) : 'field missing', ok: !!ben && (ben.radios ? ben.radios.some((r) => r.label === 'Yes' && r.checked) : /yes/i.test(ben.value)) });
+    await R.check(page, ti, { description: `${lob}: ICD code S13.4XXA listed`, expected: 'S134XXA', actual: /S13\.?4XXA/i.test(s.body) ? 'listed' : 'not listed', ok: /S13\.?4XXA/i.test(s.body) });
+  }));
+}
+
+// ── Subrogation on more LOBs (V1.0 TC058/TC059 are WI Personal Auto) ───────────────────────────────────────────────
+for (const [id, kind, lob] of [['RX013', 'HO', 'Homeowners'], ['RX014', 'CA', 'Commercial Auto']]) {
+  test(`RG-${id} [Subrogation - LOB variants]: ${lob} — Referred to Subro enables Subrogation (Open) and routes it`, async ({ page }, ti) => S.blockable(test, async () => {
+    const { cn } = await share(page, kind, `RG-${id}`);
+    R.setClaim(ti, cn, process.env.CC_USER);
+    await B.openExistingClaim(page, cn);
+    await A.openLossDetailsGeneral(page);
+    await A.editAndSave(page, 'Referred to Subro = Yes', async () => {
+      const f = (await S.readScreen(page)).fields.find((x) => /referred to subro/i.test(x.label));
+      if (!f) throw new W.Blocked('no "Referred to Subro" on Loss Details');
+      if (f.radios) await W.answer(page, f.label, 'Yes'); else await A.selectByLabel(page, f.label, 'Yes');
+      const adj = (await S.readScreen(page)).fields.find((x) => /subro.*adjuster/i.test(x.label) && x.kind === 'select');
+      if (adj) await A.selectByLabel(page, adj.label, /^(?!<none>$).+/);
+    });
+    await S.nav(page, /^Subrogation$/i);
+    const sub = await S.bodyText(page);
+    await R.check(page, ti, { description: `${lob}: Subrogation screen Open`, expected: 'Open', actual: (sub.match(/Status[^\n]{0,40}/) || ['no status'])[0], ok: /\bOpen\b/.test(sub) });
+    const act = await S.activities(page, cn, /Subrogation/i);
+    await R.check(page, ti, { description: `${lob}: subrogation activity routed`, expected: 'Subrogation Reassignment / Review activity', actual: act.join(' | ') || 'none', ok: act.length > 0 });
+  }));
+}
+
+// ── SIU fire cause of loss on commercial property (V1.0 TC045 is PA + HO) ──────────────────────────────────────────
+for (const [id, kind, lob, match] of [['RX015', 'BOP', 'BOP', 'Building|Property|Business'], ['RX016', 'CP', 'Commercial Package', 'Building|Property|Premises']]) {
+  test(`RG-${id} [Special Investigations - LOB variants]: ${lob} fire cause of loss → SIU file review`, async ({ page }, ti) => S.blockable(test, async () => {
+    const { cn } = await S.fileClaim(page, kind, `RG-${id}`, { assignmentType: 'First Party', lossCause: 'LC01', pool: false });
+    R.setClaim(ti, cn, process.env.CC_USER);
+    const before = (await S.activities(page, cn, /SIU/i)).length;
+    await S.openExposureMatching(page, match);
+    await A.editAndSave(page, 'cause of loss Fire', async () => { await A.selectByLabel(page, 'Cause of Loss', /Fire|LC01/i); });
+    const rows = await S.activities(page, cn, /SIU/i);
+    await R.check(page, ti, { description: `${lob}: SIU file review after a fire cause of loss`, expected: 'new SIU activity, SIU group', actual: rows.join(' | ') || 'none', ok: rows.length > before });
+  }));
+}
+
+// ── ISO on more LOBs (V1.0 TC056 BOP, TC057 PA) ────────────────────────────────────────────────────────────────────
+for (const [id, kind, lob] of [['RX017', 'HO', 'Homeowners'], ['RX018', 'WC', "Workers' Comp"], ['RX019', 'CA', 'Commercial Auto']]) {
+  test(`RG-${id} [ISO - LOB variants]: ${lob} claim + exposure sent to ISO`, async ({ page }, ti) => S.blockable(test, async () => {
+    const { cn } = await share(page, kind, `RG-${id}`);
+    R.setClaim(ti, cn, process.env.CC_USER);
+    let seen = '';
+    for (let t = 0; t < 20; t++) {
+      await B.openExistingClaim(page, cn);
+      await A.openLossDetailsGeneral(page);
+      await S.nav(page, /^ISO$/i).catch(() => {});
+      const s = await S.readScreen(page);
+      const st = S.findField(s, 'ISO Status') || S.findField(s, 'Status');
+      seen = st ? st.value : '(no ISO status)';
+      if (/sent/i.test(seen)) break;
+      await page.waitForTimeout(30000);
+    }
+    await R.check(page, ti, { description: `${lob}: ISO status`, expected: 'SENT', actual: seen, ok: /sent/i.test(seen) });
+  }));
+}
+
+// ── Integrations ───────────────────────────────────────────────────────────────────────────────────────────────────
+test('RG-RX020 [SmartCOMM - integration]: Document generated from a template lands on the claim', async ({ page }, ti) => S.blockable(test, async () => {
+  const D = require('../../helpers/smartComm/documentService');
+  const cn = await R.sharedClaim(page, 'PA', 'RG-RX020', { reserveActions: 0 });
+  R.setClaim(ti, cn, process.env.CC_USER);
+  const tmpl = process.env.REG_SMARTCOMM_TEMPLATE || 'Donegal Base Template';
+  const before = (await (async () => { await S.nav(page, 'Documents'); return R.gridRows(page); })()).length;
+  await B.openExistingClaim(page, cn);
+  await D.openCreateFromTemplate(page);
+  const row = await D.selectTemplate(page, tmpl);
+  if (!row) throw new W.Blocked(`template "${tmpl}" not found — set REG_SMARTCOMM_TEMPLATE`);
+  await D.setPrimaryRecipient(page, {}).catch(() => {});
+  await D.setDeliveryChannel(page, 'Print').catch(() => {});
+  await D.generateOnDemand(page, { fileNamePrefix: `RG-RX020-${cn}` });
+  await B.openExistingClaim(page, cn);
+  await S.nav(page, 'Documents');
+  const after = await R.gridRows(page);
+  await R.check(page, ti, { description: `"${tmpl}" document on the claim's Documents`, expected: 'one more document row', actual: `${before} → ${after.length}: ${after.slice(0, 3).join(' || ')}`, ok: after.length > before });
+}));
+
+test('RG-RX021 [OneInc - integration]: Homeowners check issued then voided', async ({ page }, ti) => S.blockable(test, async () => {
+  process.env.ONEINC_ALLOW_FINISH = process.env.ONEINC_ALLOW_FINISH || (['test', 'dev'].includes(B.TIER) ? '1' : '');
+  const cn = await R.sharedClaim(page, 'HO', 'RG-RX021', { reserveActions: 0 });
+  R.setClaim(ti, cn, process.env.CC_USER);
+  page.__oneIncParties = null;
+  await R.step(page, ti, await CO.createFullCheck(page, { payee: 'claimant' }));
+  await CO.openNewestCheck(page);
+  await CO.submitVoid(page);
+  await W.navigate(page, 'checks');
+  const rows = await R.gridRows(page);
+  await R.check(page, ti, { description: 'Newest check is voided (or void pending)', expected: 'Voided / Pending Void', actual: rows.slice(0, 3).join(' || '), ok: rows.slice(0, 3).some((r) => /void/i.test(r)) });
+}));
+
+test('RG-RX022 [Contact Manager - integration]: New claim contact is saved to Contact Manager', async ({ page }, ti) => S.blockable(test, async () => {
+  const CM = require('../../helpers/oneInc/contactManager');
+  const cn = await R.sharedClaim(page, 'PA', 'RG-RX022', { reserveActions: 0 });
+  R.setClaim(ti, cn, process.env.CC_USER);
+  const last = `Cmsync${Date.now().toString().slice(-6)}`;
+  await W.addClaimPersonContact(page, { first: 'Regression', last, role: 'Witness' });
+  await R.step(page, ti, `Added contact Regression ${last} (Witness) on ${cn}`);
+  const found = await CM.withCM(page, async (cm) => {
+    for (let t = 0; t < 6; t++) {
+      await cm.getByRole('textbox', { name: /Last name|Name/i }).first().fill(last);
+      await cm.getByRole('button', { name: /^Search$/ }).first().click();
+      await cm.waitForTimeout(4000);
+      if (await cm.getByText(last, { exact: false }).first().isVisible().catch(() => false)) return true;
+      await cm.waitForTimeout(20000);
+    }
+    return false;
+  });
+  await R.check(page, ti, { description: 'Contact found in Contact Manager', expected: `Regression ${last}`, actual: found ? 'found' : 'not found after ~2 minutes', ok: found });
+}));
+
+test('RG-RX023 [Recovery - integration]: Homeowners subrogation recovery reserve + receipt', async ({ page }, ti) => S.blockable(test, async () => {
+  const { cn } = await share(page, 'HO', 'RG-RX023');
+  R.setClaim(ti, cn, 'su');
+  await R.asAdmin(page, cn);
+  const before = await R.transactionRows(page, cn);
+  await B.openExistingClaim(page, cn);
+  await E.recovery(page, 'HO', 450, { skipSubro: false });
+  const added = R.newRows(before, await R.transactionRows(page, cn));
+  await R.check(page, ti, { description: 'Recovery reserve and receipt on the claim', expected: 'Recovery Reserve + Recovery $450.00', actual: added.join(' | ') || 'none', ok: added.some((r) => /Recovery/i.test(r) && /450\.00/.test(r)) });
+}));

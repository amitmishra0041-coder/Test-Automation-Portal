+  } else {
+    const c = await pooledClaim(page, kind, tag);
+    cn = c.cn;
+    await R.step(page, ti, c.reused ? `Using pooled ${kind} claim ${cn}` : `Filed a new ${kind} claim ${cn}`);
+  }
+  R.setClaim(ti, cn, process.env.CC_USER || '');
+  return cn;
+}
